{
  "name": "qingframe-web",
  "version": "0.1.6",
  "description": "本地照片加框工具：艺术边框、光影、文字 Logo、模板与多图拼贴（Electron + Canvas 2D）",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint src --ext .js",
    "validate:presets": "node tools/validate-presets.js",
    "gen:caps": "node tools/gen-style-caps.js",
    "check:caps": "node tools/gen-style-caps.js --check",
    "caps:report": "node tools/gen-style-caps.js --report",
    "test:brand": "electron tools/test-brand-logo.js",
    "test:elements": "electron tools/test-element-ops.js",
    "test:hint": "electron tools/test-logo-hint.js",
    "test:position": "electron tools/test-element-position.js",
    "test:overlay": "electron tools/test-overlay-consistency.js",
    "test:panel": "electron tools/test-panel-visibility.js",
    "test:panel:audit": "electron tools/test-panel-visibility.js --audit",
    "test:label": "electron tools/test-param-font-label.js",
    "test:leica": "electron tools/test-leica-logo-gap.js",
    "test:pol": "electron tools/test-polaroid-hand.js",
    "test:srgb": "electron tools/test-export-srgb.js",
    "test:visual": "electron tools/visual-regression.js",
    "test": "npm run check && npm run test:brand && npm run test:leica && npm run test:pol && npm run test:srgb && npm run test:elements && npm run test:hint && npm run test:position && npm run test:overlay && npm run test:label && npm run test:panel && npm run test:panel:audit && npm run test:visual",
    "check": "npm run lint && npm run validate:presets && npm run check:caps",
    "app:dir": "electron-builder --win --dir",
    "verify:dist": "node tools/verify-dist.js",
    "release": "electron-builder --win --dir && node tools/verify-dist.js && electron-builder --win",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "lumos",
  "license": "MIT",
  "build": {
    "appId": "com.qingframe.web",
    "productName": "清框影",
    "executableName": "Qingframe",
    "copyright": "Copyright © 2026 清框影",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "shared/**/*",
      "!shared/brandlogos/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lumos-1s",
        "repo": "Qing-Fram-Shadow-web"
      }
    ],
    "win": {
      "icon": "src/main/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "清框影",
      "artifactName": "Qingframe-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Qingframe-Portable-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^8.57.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
